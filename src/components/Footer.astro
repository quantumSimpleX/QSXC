---
const year = new Date().getFullYear();
---

<footer class="qsw-footer">
  <div class="qsw-footer-rule"></div>
  <div class="qsw-footer-grid">
    <div class="qsw-footer-brand">
      <a href="/" class="qsw-footer-brand-name" aria-label="Quantum SimpleX Consulting">
      <img class="logo-for-light" src="/assets/logo-black.svg" alt="Quantum SimpleX Consulting" />
      <img class="logo-for-dark"  src="/assets/logo-white.svg" alt="Quantum SimpleX Consulting" />
    </a>
      <p>Building the scaffolding<br />for AI transformation.</p>
    </div>
    <div class="qsw-footer-cols">
      <div>
        <div class="qs-eyebrow">Services</div>
        <ul>
          <li><a href="/services#inspire">Level 1: Inspire</a></li>
          <li><a href="/services#mobilize">Level 2: Mobilize</a></li>
          <li><a href="/services#transform">Level 3: Transform</a></li>
        </ul>
      </div>
      <div>
        <div class="qs-eyebrow">Company</div>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/book">Book a Call</a></li>
        </ul>
      </div>
      <div>
        <div class="qs-eyebrow">Connect</div>
        <ul>
          <li><a href="#" aria-label="LinkedIn">LinkedIn</a></li>
          <li><a href="#" aria-label="GitHub">GitHub</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="qsw-footer-bottom">
    <span>© {year} Quantum SimpleX Consulting.</span>
    <span class="qs-mono">v.{year}.06</span>
  </div>
</footer>
